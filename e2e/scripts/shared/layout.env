# Single source of the names the harness shares with the scenario modules.
# Plain KEY=VALUE lines; parsed by harness/config.py and sourceable from shell.
E2E_SCENARIOKIT_MODULE=scenariokit
E2E_SCENARIOS_MODULE=scenarios
E2E_CATALOG_JSON=e2e/catalog/scenarios.json
E2E_ANDROID_TEST_MODULE=scenariorunner
E2E_ANDROID_TEST_ASSEMBLE_TASK=:scenariorunner:assembleDebug
E2E_ANDROID_TEST_PACKAGE=com.gdavidpb.tuindice.scenariorunner
E2E_ANDROID_TEST_RUNNER=androidx.test.runner.AndroidJUnitRunner
E2E_IOS_UITEST_DIR=iosApp/UITests
E2E_IOS_UITEST_SCHEME=TuIndiceUITests
# Extension points of the orchestrator: the fingerprint and scope scripts live next to it, and the status
# context has one definition (e2e_status_context in .github/scripts/common.sh), shared with the detector.
E2E_FINGERPRINT_SCRIPT=e2e/scripts/shared/e2e-fingerprint.sh
E2E_FINGERPRINT_VERSION=v5
E2E_SCOPE_SCRIPT=e2e/scripts/shared/resolve-e2e-scope.sh
E2E_STATUS_CONTEXT_SOURCE=.github/scripts/common.sh
E2E_MOCK_START_SCRIPT=mocks/start-mock-enviroment.sh
E2E_ADAPTER_ROOT=e2e/scripts
E2E_TOOLCHAIN_DIR=e2e/toolchain
