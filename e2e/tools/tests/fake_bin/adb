#!/usr/bin/env bash
# Fake adb for the device.sh tests. State lives in $FAKE_ADB_DIR:
#   online            exists while the emulator is online (the fake emulator creates it)
#   loadavg.seq       lines consumed one per read as the first /proc/loadavg field; the last one repeats
#   anr               exists: dumpsys window shows an ANR window
#   boot_completed    contents override sys.boot_completed (default 1)
#   offline_polls     after `reboot`, `devices` hides the emulator for this many calls
#   ignore            "<namespace> <key>" lines whose `settings put` is silently ignored
#   props/<name>      overrides a getprop value; nproc and meminfo_kb override those reads
#   calls.log         one line per call
set -euo pipefail

dir="${FAKE_ADB_DIR:?FAKE_ADB_DIR is required}"
mkdir -p "${dir}/settings" "${dir}/props"
printf '%s\n' "$*" >> "${dir}/calls.log"

if [[ "${1:-}" == "-s" ]]; then
	shift 2
fi
verb="${1:-}"
if (( $# > 0 )); then shift; fi

prop() { # name default
	if [[ -f "${dir}/props/$1" ]]; then cat "${dir}/props/$1"; else printf '%s\n' "$2"; fi
}

case "${verb}" in
	version) echo "Android Debug Bridge version 1.0.41" ;;
	devices)
		echo "List of devices attached"
		if [[ -f "${dir}/offline_polls" ]]; then
			left="$(cat "${dir}/offline_polls")"
			if (( left > 0 )); then
				echo $((left - 1)) > "${dir}/offline_polls"
			else
				rm -f "${dir}/offline_polls"
			fi
		fi
		if [[ -f "${dir}/online" && ! -f "${dir}/offline_polls" ]]; then printf 'emulator-5554\tdevice\n'; fi
		;;
	emu)
		if [[ "${1:-}" == "avd" ]]; then printf '%s\nOK\n' "${FAKE_AVD_NAME:-Pixel_10_Pro_XL}"; fi
		if [[ "${1:-}" == "kill" ]]; then rm -f "${dir}/online"; fi
		;;
	reboot) echo 2 > "${dir}/offline_polls" ;;
	reverse)
		if [[ "${1:-}" == "--list" ]]; then
			[[ ! -f "${dir}/reverse" ]] || cat "${dir}/reverse"
		else
			printf 'host-1 %s %s\n' "$1" "$2" >> "${dir}/reverse"
		fi
		;;
	shell)
		sub="${1:-}"
		if (( $# > 0 )); then shift; fi
		case "${sub}" in
			getprop)
				case "$1" in
					sys.boot_completed) if [[ -f "${dir}/boot_completed" ]]; then cat "${dir}/boot_completed"; else echo 1; fi ;;
					init.svc.bootanim) echo stopped ;;
					ro.build.version.sdk) prop sdk 37 ;;
					persist.sys.locale) prop locale es-VE ;;
					ro.product.locale) prop product_locale en-US ;;
					ro.product.model) echo "Pixel 10 Pro XL" ;;
				esac
				;;
			settings)
				if [[ "$1" == "put" ]]; then
					if ! grep -qxF -e "$2 $3" "${dir}/ignore" 2> /dev/null; then printf '%s\n' "$4" > "${dir}/settings/$2.$3"; fi
				else
					if [[ -f "${dir}/settings/$2.$3" ]]; then cat "${dir}/settings/$2.$3"; else echo null; fi
				fi
				;;
			pm) echo "package:/system/framework/framework-res.apk" ;;
			dumpsys)
				if [[ "$1" == "window" ]]; then
					if [[ -f "${dir}/anr" ]]; then echo "Window #1 Application Not Responding: com.example"; else echo "Window #1"; fi
				else
					echo "mResumedActivity: ActivityRecord{1 u0 com.example/.Main}"
				fi
				;;
			cat)
				case "$1" in
					/proc/loadavg)
						if [[ -f "${dir}/loadavg.seq" ]]; then
							first="$(head -n 1 "${dir}/loadavg.seq")"
							if [[ "$(wc -l < "${dir}/loadavg.seq")" -gt 1 ]]; then tail -n +2 "${dir}/loadavg.seq" > "${dir}/loadavg.tmp"; mv "${dir}/loadavg.tmp" "${dir}/loadavg.seq"; fi
						else
							first="1.20"
						fi
						echo "${first} 1.00 0.90 1/500 1234"
						;;
					/proc/uptime) echo "120.50 400.10" ;;
					/proc/meminfo) printf 'MemTotal:       %s kB\n' "$(prop meminfo_kb 8000000)" ;;
				esac
				;;
			nproc) prop nproc 6 ;;
		esac
		;;
	*) echo "fake adb: unsupported $verb" >&2; exit 64 ;;
esac
