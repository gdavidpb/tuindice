#!/usr/bin/env bash
# Fake xcodebuild for the adapter tests. State lives in $FAKE_XCRUN_DIR (the same directory as the fake xcrun):
#   tests.list     identifiers `-enumerate-tests` writes to -test-enumeration-output-path
#   xc.rc          exit status of a test run (default 0)
#   xc.id/xc.result  the scenario id and the result.json a test run leaves under $TEST_RUNNER_E2E_OUTPUT_DIR/<id>/
#   xc.driverlog   the driver.log a test run leaves under $TEST_RUNNER_E2E_OUTPUT_DIR/<id>/ before it ends or hangs
#   xc.hang        exists: a test run never ends
#   calls.log      one line per call, followed by the TEST_RUNNER_ variables it saw
set -euo pipefail

dir="${FAKE_XCRUN_DIR:?FAKE_XCRUN_DIR is required}"
mkdir -p "${dir}"
printf 'xcodebuild %s\n' "$*" >> "${dir}/calls.log"
env | grep '^TEST_RUNNER_' | sed 's/^/env /' >> "${dir}/calls.log" || printf 'no TEST_RUNNER_ variables\n' >> "${dir}/calls.log"

if [[ " $* " == *" -enumerate-tests "* ]]; then
	out=""
	while (( $# > 0 )); do
		[[ "$1" == "-test-enumeration-output-path" ]] && out="$2"
		shift
	done
	python3 - "${out}" "${dir}/tests.list" << 'PY'
import json, sys
names = open(sys.argv[2]).read().split()
json.dump({"errors": [], "values": [{"disabledTests": [], "enabledTests": [{"identifier": n} for n in names]}]}, open(sys.argv[1], "w"))
PY
	exit 0
fi

if [[ -f "${dir}/xc.driverlog" ]]; then  # what a run writes line by line before it ends
	mkdir -p "${TEST_RUNNER_E2E_OUTPUT_DIR}/$(cat "${dir}/xc.id")"
	cp "${dir}/xc.driverlog" "${TEST_RUNNER_E2E_OUTPUT_DIR}/$(cat "${dir}/xc.id")/driver.log"
fi
if [[ -f "${dir}/xc.hang" ]]; then sleep 300; fi
if [[ -f "${dir}/xc.result" ]]; then
	mkdir -p "${TEST_RUNNER_E2E_OUTPUT_DIR}/$(cat "${dir}/xc.id")"
	cp "${dir}/xc.result" "${TEST_RUNNER_E2E_OUTPUT_DIR}/$(cat "${dir}/xc.id")/result.json"
fi
# One passed test case per -only-testing selection, the way xcodebuild reports them.
count=0
for arg in "$@"; do
	if [[ "${arg}" == -only-testing:* ]]; then
		selection="${arg#-only-testing:}"
		klass="$(cut -d/ -f2 <<< "${selection}")"
		printf "Test Case '-[TuIndiceUITests.%s test_fake]' passed (0.1 seconds).\n" "${klass}"
		count=$((count + 1))
	fi
done
(( count > 0 )) || count=1
printf "Test Suite 'Selected tests' passed.\n\t Executed %d test%s, with 0 failures (0 unexpected) in 1.0 (1.0) seconds\n" "${count}" "$([[ ${count} -eq 1 ]] || printf s)"
exit "$(cat "${dir}/xc.rc" 2> /dev/null || echo 0)"
