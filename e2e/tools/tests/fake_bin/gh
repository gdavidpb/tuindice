#!/usr/bin/env bash
# Fake gh for the harness tests. It records every call and can be told to fail:
#   E2E_FAKE_GH_LOG        file that receives one line per call (required)
#   E2E_FAKE_GH_FAIL_FILE  while this file exists, the status POST fails
#   E2E_FAKE_GH_AUTH_FAIL  when non-empty, `gh auth status` fails
#   E2E_FAKE_GH_STATUSES_DIR  directory of <sha>.json: what `commits/<sha>/statuses` answers ([] when absent)
#   E2E_FAKE_GH_OWNER      what `repos/{owner}/{repo}` answers (default "owner"; set but empty: nothing)
#   E2E_FAKE_GH_UNREACHABLE  when non-empty, every GET fails
#   E2E_FAKE_GH_SLEEP      seconds the status POST takes before it answers (a gh that hangs)
#   E2E_FAKE_GH_FAIL_SHAS  space-separated SHAs whose statuses query fails (HTTP 500)
#   E2E_FAKE_GH_FAIL_ONCE_SHAS  space-separated SHAs whose statuses query fails the first time and answers afterwards
#   E2E_FAKE_GH_MISSING_SHAS  space-separated SHAs GitHub does not know (HTTP 422, as for an unpushed commit)
set -euo pipefail

printf '%s\n' "$*" >> "${E2E_FAKE_GH_LOG:?E2E_FAKE_GH_LOG is required}"

if [[ "${1:-}" == "auth" ]]; then
	[[ -z "${E2E_FAKE_GH_AUTH_FAIL:-}" ]] || exit 1
	exit 0
fi

if [[ "${1:-}" != "api" ]]; then
	exit 64
fi

shift
method="GET"
endpoint=""
state=""
context=""
description=""
while (( $# > 0 )); do
	case "$1" in
		-X)
			method="$2"
			shift 2
			;;
		-f)
			case "$2" in
				state=*) state="${2#state=}" ;;
				context=*) context="${2#context=}" ;;
				description=*) description="${2#description=}" ;;
			esac
			shift 2
			;;
		--jq)
			shift 2
			;;
		*)
			endpoint="$1"
			shift
			;;
	esac
done

if [[ "${method}" == "POST" ]]; then
	if [[ -n "${E2E_FAKE_GH_SLEEP:-}" ]]; then
		exec sleep "${E2E_FAKE_GH_SLEEP}"
	fi
	if [[ -n "${E2E_FAKE_GH_FAIL_FILE:-}" && -e "${E2E_FAKE_GH_FAIL_FILE}" ]]; then
		printf 'HTTP 502: bad gateway\n' >&2
		exit 1
	fi
	printf '{"state":"%s","context":"%s","description":"%s"}\n' "${state}" "${context}" "${description}"
	exit 0
fi

if [[ -n "${E2E_FAKE_GH_UNREACHABLE:-}" ]]; then
	printf 'could not resolve host\n' >&2
	exit 1
fi

# Reads of the evidence verdict: the owner, and the statuses of a commit from $E2E_FAKE_GH_STATUSES_DIR/<sha>.json.
if [[ "${endpoint}" == "repos/{owner}/{repo}" ]]; then
	printf '%s\n' "${E2E_FAKE_GH_OWNER-owner}"
	exit 0
fi
if [[ "${endpoint}" == */commits/*/statuses ]]; then
	sha="${endpoint%/statuses}"
	sha="${sha##*/}"
	case " ${E2E_FAKE_GH_FAIL_SHAS:-} " in
		*" ${sha} "*) printf 'HTTP 500: server error\n' >&2; exit 1 ;;
	esac
	case " ${E2E_FAKE_GH_FAIL_ONCE_SHAS:-} " in
		*" ${sha} "*)
			if [[ ! -e "${E2E_FAKE_GH_LOG}.failed-${sha}" ]]; then
				: > "${E2E_FAKE_GH_LOG}.failed-${sha}"
				printf 'HTTP 502: bad gateway\n' >&2
				exit 1
			fi
			;;
	esac
	case " ${E2E_FAKE_GH_MISSING_SHAS:-} " in
		*" ${sha} "*) printf 'HTTP 422: No commit found for SHA: %s\n' "${sha}" >&2; exit 1 ;;
	esac
fi
if [[ -n "${E2E_FAKE_GH_STATUSES_DIR:-}" && "${endpoint}" == */commits/*/statuses ]]; then
	sha="${endpoint%/statuses}"
	sha="${sha##*/}"
	if [[ -f "${E2E_FAKE_GH_STATUSES_DIR}/${sha}.json" ]]; then
		cat "${E2E_FAKE_GH_STATUSES_DIR}/${sha}.json"
	else
		printf '[]\n'
	fi
	exit 0
fi

printf '%s\n' "${endpoint##*/}"
