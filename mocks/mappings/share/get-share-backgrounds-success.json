{
  "request": {
    "method": "GET",
    "urlPath": "/users/v1/share-backgrounds",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "share-backgrounds-response-transformer"
    ],
    "fixedDelayMilliseconds": 500
  }
}
