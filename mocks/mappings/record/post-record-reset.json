{
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/reset",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "record-response-transformer"
    ]
  }
}
