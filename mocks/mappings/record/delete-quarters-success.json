{
  "request": {
    "method": "DELETE",
    "urlPathPattern": "/quarters/v1/[A-Za-z0-9]+",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.mutation_id"
      },
      {
        "matchesJsonPath": "$.expected_revision"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"mutation_id\":\"{{jsonPath request.body '$.mutation_id'}}\",\"removed_quarter_id\":\"{{request.pathSegments.[2]}}\",\"affected_quarters\":{{{toJson record.quarters}}} }",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1000
  }
}
