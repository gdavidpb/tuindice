{
  "priority": 5,
  "scenarioName": "record-term-MOCK-ADDED-QUARTER",
  "requiredScenarioState": "ADDED_R1",
  "request": {
    "method": "POST",
    "urlPath": "/record/v1/overlay/terms",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.label"
      },
      {
        "matchesJsonPath": "$.start_at"
      },
      {
        "matchesJsonPath": "$.end_at"
      },
      {
        "matchesJsonPath": "$.attempts"
      },
      {
        "matchesJsonPath": "$.attempts[0].subject_code"
      }
    ]
  },
  "response": {
    "status": 412,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"error\":\"term_already_exists\"}",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1200
  }
}
