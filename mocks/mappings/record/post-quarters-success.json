{
  "request": {
    "method": "POST",
    "urlPath": "/quarters/v1",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.quarter"
      },
      {
        "matchesJsonPath": "$.year"
      },
      {
        "matchesJsonPath": "$.subjects"
      },
      {
        "matchesJsonPath": "$.subjects[0].code"
      },
      {
        "matchesJsonPath": "$.subjects[0].grade"
      },
      {
        "matchesJsonPath": "$.mutation_id"
      },
      {
        "matchesJsonPath": "$[?(@.expected_revision == 11)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"mutation_id\":\"{{jsonPath request.body '$.mutation_id'}}\",\"quarter_patch\":{{{toJson record.addedQuarter}}},\"affected_quarters\":{{{toJson record.quarters}}} }",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1200
  }
}
