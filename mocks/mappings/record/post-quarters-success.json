{
  "request": {
    "method": "POST",
    "urlPath": "/quarters/v1",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.quarter"
      },
      {
        "matchesJsonPath": "$.year"
      },
      {
        "matchesJsonPath": "$.subjects"
      },
      {
        "matchesJsonPath": "$.subjects[0].code"
      },
      {
        "matchesJsonPath": "$.subjects[0].grade"
      },
      {
        "matchesJsonPath": "$.mutation_id"
      },
      {
        "matchesJsonPath": "$[?(@.expected_revision == 10)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "record/post-quarters-success-body.json",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1200
  }
}
