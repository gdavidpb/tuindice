{
  "request": {
    "method": "PATCH",
    "urlPathPattern": "/quarters/v1/[^/]+/subjects/[^/]+",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.grade"
      },
      {
        "matchesJsonPath": "$.mutation_id"
      },
      {
        "matchesJsonPath": "$.expected_revision"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "record/patch-quarter-subject-grade-success-body.json",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1500
  }
}
