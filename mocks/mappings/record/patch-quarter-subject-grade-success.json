{
  "request": {
    "method": "PATCH",
    "urlPathPattern": "/quarters/v1/[^/]+/subjects/[^/]+",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.grade"
      },
      {
        "matchesJsonPath": "$.mutation_id"
      },
      {
        "matchesJsonPath": "$.expected_revision"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"mutation_id\":\"{{jsonPath request.body '$.mutation_id'}}\",\"subject_patch\":{{{toJson record.currentSubject}}},\"affected_quarters\":{{{toJson record.quarters}}} }",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1500
  }
}
