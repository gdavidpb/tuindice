{
  "priority": 1,
  "scenarioName": "record-term-MOCK-ADDED-TERM",
  "requiredScenarioState": "DELETED_R2",
  "newScenarioState": "ADDED_R1",
  "request": {
    "method": "POST",
    "urlPath": "/record/v3/overlay/terms",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.label"
      },
      {
        "matchesJsonPath": "$.start_at"
      },
      {
        "matchesJsonPath": "$.end_at"
      },
      {
        "matchesJsonPath": "$.attempts"
      },
      {
        "matchesJsonPath": "$.attempts[0].subject_code"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{{{toJson record}}}",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 1200
  }
}
