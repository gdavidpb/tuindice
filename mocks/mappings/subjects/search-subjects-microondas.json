{
  "request": {
    "method": "GET",
    "urlPath": "/subjects/v1/search",
    "queryParameters": {
      "query": {
        "contains": "microondas"
      }
    },
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 250,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "subjects/search-subjects-microondas.json"
  }
}
