{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/evaluations/v3",
    "headers": {
      "Authorization": {
        "matches": "Bearer summary\\.hub(\\.nopensum)?\\.mock\\.access"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
