{
  "priority": 1,
  "scenarioName": "evaluations-pending-sign-out",
  "requiredScenarioState": "Unavailable",
  "request": {
    "method": "POST",
    "urlPath": "/evaluations/v3",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.type == 0 && @.date == null)]"
      }
    ],
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 500
  }
}
