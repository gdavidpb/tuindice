{
  "request": {
    "method": "POST",
    "urlPath": "/evaluations/v3",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "evaluations-response-transformer"
    ]
  }
}
