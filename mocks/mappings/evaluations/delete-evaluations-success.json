{
  "request": {
    "method": "DELETE",
    "urlPath": "/evaluations",
    "queryParameters": {
      "eid": {
        "matches": "[A-Za-z0-9]+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 1500
  }
}