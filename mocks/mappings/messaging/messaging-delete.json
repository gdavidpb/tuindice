{
  "request": {
    "method": "DELETE",
    "urlPath": "/messaging/v1",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 3000
  }
}
