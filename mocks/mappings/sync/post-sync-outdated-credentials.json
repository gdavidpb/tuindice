{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/sync",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'outdated-pass')]"
      }
    ]
  },
  "response": {
    "status": 409,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 500
  }
}
