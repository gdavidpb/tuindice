{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/sync",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'enrollment-unavailable-pass')]"
      }
    ],
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sync/post-sync-enrollment-unavailable.json",
    "fixedDelayMilliseconds": 1000
  }
}
