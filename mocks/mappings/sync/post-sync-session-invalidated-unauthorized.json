{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/sync",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer expired.session.mock.access"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'expired-pass')]"
      }
    ]
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 500
  }
}
