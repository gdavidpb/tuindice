{
  "scenarioName": "login-token-lifecycle",
  "requiredScenarioState": "TokensIssued",
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/sync",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sync/post-sync-success.json",
    "fixedDelayMilliseconds": 6000
  },
  "metadata": {
    "fastDelayMilliseconds": 250
  }
}
