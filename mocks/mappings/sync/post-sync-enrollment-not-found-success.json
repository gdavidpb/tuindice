{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/record/v5/sync",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'enrollment-not-found-pass')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sync/post-sync-success.json",
    "fixedDelayMilliseconds": 1000
  }
}
