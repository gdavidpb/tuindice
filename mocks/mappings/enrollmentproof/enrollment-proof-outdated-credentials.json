{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/enrollment-proof/v1",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'outdated-pass')]"
      }
    ],
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "outdated credentials"
    },
    "fixedDelayMilliseconds": 3000
  }
}
