{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/enrollment-proof/v1",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'enrollment-unavailable-pass')]"
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "enrollment proof temporarily unavailable"
    },
    "fixedDelayMilliseconds": 3000
  }
}
