{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v1/sessions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.platform == 'iOS')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "session_id": "mock-attestation-session-ios",
      "challenge": "mock-attestation-challenge-ios",
      "expires_at": 2524608000000
    },
    "fixedDelayMilliseconds": 250
  }
}
