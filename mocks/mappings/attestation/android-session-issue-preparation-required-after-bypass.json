{
  "scenarioName": "android-attestation-preparation",
  "requiredScenarioState": "PreparationRequired",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v4/sessions",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.platform == 'Android')]"
      },
      {
        "matchesJsonPath": "$[?(@.operation_code == 'auth.exchange')]"
      },
      {
        "matchesJsonPath": "$.key_id"
      }
    ]
  },
  "response": {
    "status": 428,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "attestation_not_prepared",
      "required_preparation_code": "bootstrap"
    },
    "fixedDelayMilliseconds": 250
  }
}
