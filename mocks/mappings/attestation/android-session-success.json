{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v2/sessions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.platform == 'Android')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "session_id": "mock-attestation-session-android",
      "challenge": "mock-attestation-challenge-android",
      "expires_at": 2524608000000,
      "evidence_mode": "play_integrity"
    },
    "fixedDelayMilliseconds": 250
  }
}
