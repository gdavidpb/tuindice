{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v4/sessions",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.platform == 'Android')]"
      },
      {
        "matchesJsonPath": "$[?(@.operation_code == 'auth.refresh_tokens')]"
      },
      {
        "matchesJsonPath": "$.key_id"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "session_id": "mock-attestation-session-android-refresh",
      "challenge": "mock-attestation-challenge-android",
      "expires_at": 2524608000000,
      "evidence_mode": "play_integrity_standard"
    },
    "fixedDelayMilliseconds": 250
  }
}
