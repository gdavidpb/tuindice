{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v4/tokens",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.session_id =~ /mock-attestation-session-android-(exchange|reissue)/)]"
      },
      {
        "matchesJsonPath": "$.operation_code"
      },
      {
        "matchesJsonPath": "$.request_hash"
      },
      {
        "matchesJsonPath": "$[?(@.evidence_mode == 'play_integrity_classic')]"
      },
      {
        "matchesJsonPath": "$[?(@.token =~ /(android-debug-attestation|android-remote-config-bypass):.+/)]"
      },
      {
        "matchesJsonPath": "$.key_id"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "token": "attestation.mock.proof.android",
      "expires_at": 2524608000000
    },
    "fixedDelayMilliseconds": 250
  }
}
