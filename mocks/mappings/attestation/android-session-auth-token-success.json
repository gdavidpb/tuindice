{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v4/tokens",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.session_id == 'mock-attestation-session-android-session-auth')]"
      },
      {
        "matchesJsonPath": "$[?(@.operation_code =~ /auth\\.(refresh_tokens|revoke_tokens)/)]"
      },
      {
        "matchesJsonPath": "$.request_hash"
      },
      {
        "matchesJsonPath": "$[?(@.evidence_mode == 'play_integrity_standard')]"
      },
      {
        "matchesJsonPath": "$[?(@.token =~ /(android-debug-attestation|android-remote-config-bypass):.+/)]"
      },
      {
        "matchesJsonPath": "$.key_id"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "token": "attestation.mock.proof.android",
      "expires_at": 2524608000000
    },
    "fixedDelayMilliseconds": 250
  }
}
