{
  "request": {
    "method": "POST",
    "urlPath": "/attestation/v2/tokens",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.session_id == 'mock-attestation-session-android')]"
      },
      {
        "matchesJsonPath": "$.operation_code"
      },
      {
        "matchesJsonPath": "$.request_hash"
      },
      {
        "matchesJsonPath": "$[?(@.evidence_mode =~ /play_integrity_(classic|standard)/)]"
      },
      {
        "matchesJsonPath": "$[?(@.token =~ /android-debug-attestation:.+/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "token": "attestation.mock.proof.android",
      "expires_at": 2524608000000
    },
    "fixedDelayMilliseconds": 250
  }
}
