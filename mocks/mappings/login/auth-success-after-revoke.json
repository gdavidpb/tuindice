{
  "scenarioName": "login-token-lifecycle",
  "requiredScenarioState": "TokensRevoked",
  "newScenarioState": "TokensIssued",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token",
    "headers": {
      "Authorization": {
        "equalTo": "Basic MTEtMTExMTE6MTIzNDU2"
      },
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      },
      "X-Attested-Flow": {
        "matches": "(issue|reissue)_tokens"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "uid": "0IQZf2qtYZOTwutEX38qvBY5H8l2",
      "usb_id": "11-11111",
      "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.reissued.mock.access",
      "refresh_token": "refresh.mock.token.reissued",
      "expires_in": 3600
    },
    "fixedDelayMilliseconds": 5000
  }
}
