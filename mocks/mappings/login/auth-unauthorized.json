{
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token",
    "headers": {
      "Authorization": {
        "doesNotMatch": "Basic MTEtMTExMTE6MTIzNDU2"
      },
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      },
      "X-Attested-Flow": {
        "matches": "(issue|reissue)_tokens"
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 3000
  }
}
