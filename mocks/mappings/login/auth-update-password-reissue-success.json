{
  "priority": 1,
  "scenarioName": "auth-update-password-login",
  "requiredScenarioState": "TokensIssued",
  "newScenarioState": "TokensUpdated",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token",
    "headers": {
      "Authorization": {
        "equalTo": "Basic NTUtNTU1NTU6MTIzNDU2"
      },
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      },
      "X-Attested-Flow": {
        "equalTo": "reissue_tokens"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "uid": "update-password-user",
      "usb_id": "55-55555",
      "session_id": "auth-update-password-session-updated",
      "access_token": "update.password.mock.access.updated",
      "refresh_token": "update.password.mock.refresh.updated",
      "expires_in": 3600
    },
    "fixedDelayMilliseconds": 2000
  }
}
