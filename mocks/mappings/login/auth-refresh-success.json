{
  "request": {
    "method": "POST",
    "urlPath": "/auth/token/refresh",
    "headers": {
      "X-Risk-Attestation": {
        "matches": "risk\\.mock\\.proof\\.(android|ios)"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.access_token"
      },
      {
        "matchesJsonPath": "$.refresh_token"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.mock.access",
      "refresh_token": "refresh.mock.token.value",
      "expires_in": 3600
    },
    "fixedDelayMilliseconds": 1000
  }
}
