{
  "scenarioName": "login-token-lifecycle",
  "requiredScenarioState": "TokensIssued",
  "newScenarioState": "TokensIssued",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v2/token/refresh",
    "headers": {
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.session_id"
      },
      {
        "matchesJsonPath": "$.refresh_token"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "session_id": "auth-session-refreshed",
      "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.mock.access",
      "refresh_token": "refresh.mock.token.value",
      "expires_in": 3600
    },
    "fixedDelayMilliseconds": 1000
  }
}
