{
  "priority": 1,
  "scenarioName": "auth-summary-hub-login",
  "requiredScenarioState": "BootstrapIssued",
  "newScenarioState": "TokensIssued",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v2/token/exchange",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer bootstrap.mock.summary-hub.token"
      },
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "uid": "summary-hub-user",
      "usb_id": "41-41414",
      "session_id": "summary-hub-session",
      "access_token": "summary.hub.mock.access",
      "refresh_token": "summary.hub.mock.refresh",
      "expires_in": 3600
    },
    "fixedDelayMilliseconds": 1000
  }
}
