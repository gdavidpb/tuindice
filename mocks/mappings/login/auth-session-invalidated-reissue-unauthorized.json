{
  "priority": 1,
  "scenarioName": "auth-session-invalidated-login",
  "requiredScenarioState": "TokensIssued",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token",
    "headers": {
      "Authorization": {
        "equalTo": "Basic NjYtNjY2NjY6ZXhwaXJlZC1wYXNz"
      },
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      },
      "X-Attested-Flow": {
        "equalTo": "reissue_tokens"
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 500
  }
}
