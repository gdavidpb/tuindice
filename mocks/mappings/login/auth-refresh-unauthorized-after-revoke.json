{
  "scenarioName": "login-token-lifecycle",
  "requiredScenarioState": "TokensRevoked",
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token/refresh",
    "headers": {
      "X-Attestation-Token": {
        "matches": "attestation\\.mock\\.proof\\.(android|ios)"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.access_token"
      },
      {
        "matchesJsonPath": "$.refresh_token"
      }
    ]
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 1000
  }
}
