{
  "request": {
    "method": "POST",
    "urlPath": "/auth/v2/token/revoke",
    "bodyPatterns": [
      {
        "equalToJson": "{}"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": 400,
      "message": "Invalid revoke tokens request"
    },
    "fixedDelayMilliseconds": 500
  }
}
