{
  "request": {
    "method": "POST",
    "urlPath": "/auth/v1/token/revoke",
    "headers": {
      "Authorization": {
        "absent": true
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": 401,
      "message": "Jwt is missing"
    },
    "fixedDelayMilliseconds": 500
  }
}
