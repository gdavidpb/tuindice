{
  "request": {
    "method": "GET",
    "urlPath": "/pensums/v2",
    "queryParameters": {
      "year": {
        "equalTo": "2016"
      },
      "modality_id": {
        "equalTo": "degree_project"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "pensums/get-pensum-2016-degree_project.json"
  }
}
