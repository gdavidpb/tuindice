{
  "request": {
    "method": "GET",
    "urlPath": "/pensums/v4",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "pensums/get-pensum-success.json",
    "fixedDelayMilliseconds": 1800
  },
  "priority": 10
}
